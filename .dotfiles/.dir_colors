# Specifies the color used for a symbolic link.
LINK target

# Specifies the color used for a regular file with capability.
CAPABILITY 0

# Specifies the color used for a door.
DOOR 0

# Specifies the color used for a regular file.
FILE 0

# Specifies the color used for a missing file.
MISSING 0

# Specifies the color used for normal text.
NORMAL 0

# Specifies the color used for directories.
DIR 38;5;30

# Specifies the color used for a block device special file.
BLK 38;5;68

# Specifies the color used for a character device special file.
CHR 38;5;113

# Specifies the color used for an orphaned symbolic link.
ORPHAN 38;5;124

# Specifies the color used for a named pipe.
FIFO 38;5;126

# Specifies the color used for a socket.
SOCK 38;5;197

# Specifies the color used for a file with the executable attribute set.
EXEC 38;5;202

# Specifies the color used for a regular file with more than one link.
MULTIHARDLINK 38;5;216

# Specifies the color used for an other-writable directory without the executable attribute set.
OTHER_WRITABLE 38;5;220;100

# Specifies the color used for a file with the set-group-ID attribute set.
SETGID 38;5;220;100

# Specifies the color used for a file with the set-user-ID attribute set.
SETUID 38;5;220;100

# Specifies the color used for a directory with the sticky attribute set.
STICKY 38;5;220;100

# Specifies the color used for an other-writable directory with the executable attribute set.
STICKY_OTHER_WRITABLE 38;5;220;100

