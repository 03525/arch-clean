alias copy='wl-copy'
alias diff='diff --color=auto'
alias grep='grep --color=auto --exclude-dir={.git,.idea,.venv}'
alias la='ls -a'
alias ll='ls -l'
alias lr='ls -r'
alias ls='ls --color=auto --classify=always --quoting-style=escape --time-style=long-iso'
alias pacman='pacman --color=auto'
alias qalc='qalc -s "vspace off" -s "autocalc on" -s "clear history yes" -s "save config no"'
alias sudo='sudo '
alias vim='vim -Y'
alias which='where'
